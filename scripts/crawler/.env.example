# Supabase 설정 (service_role 키 사용 — RLS 우회)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# 크롤러 봇 계정 UUID (Supabase Auth에서 생성 후 profiles에 role=operator로 등록)
# 없으면 빈칸으로 두어도 됨 (created_by=null)
CRAWLER_USER_ID=

# AI poster verification. By default, unverified images are rejected.
# Set OPENAI_API_KEY in production if you want the crawler to collect posters.
OPENAI_API_KEY=
POSTER_IMAGE_CLASSIFIER=auto
OPENAI_POSTER_IMAGE_MODEL=gpt-5-mini
POSTER_IMAGE_MIN_CONFIDENCE=0.65
POSTER_IMAGE_ALLOW_UNVERIFIED=0
POSTER_LOCAL_MODEL_PATH=
POSTER_LOCAL_MODEL_THRESHOLD=0.65
POSTER_AI_PYTHON=python
POSTER_CONTENT_VERIFIER=auto
OPENAI_POSTER_CONTENT_MODEL=gpt-5-mini
POSTER_CONTENT_MIN_CONFIDENCE=0.6
POSTER_CONTENT_ALLOW_UNVERIFIED=0
POSTER_CONTENT_ALLOW_ON_ERROR=0
POSTER_IMAGE_RULE_MIN_SCORE=45

# AI field verification (deadline/organization name accuracy check)
POSTER_FIELD_VERIFIER=auto
OPENAI_POSTER_FIELD_MODEL=gpt-5-mini
POSTER_FIELD_VERIFIER_MIN_CONFIDENCE=0.6
POSTER_FIELD_VERIFIER_ALLOW_ON_ERROR=1

# Semantic embeddings for recommendation (title+summary -> pgvector)
POSTER_EMBEDDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SNS_INGESTION.md Phase 2 — 관련성 분류기(공고/소식/폐기 라우팅 + 필드 추출)
POSTER_RELEVANCE_ROUTER=auto
OPENAI_POSTER_ROUTER_MODEL=gpt-5-mini
POSTER_RELEVANCE_ROUTER_MIN_CONFIDENCE=0.6
POSTER_RELEVANCE_ROUTER_CONTEXT_CHARS=4500
POSTER_RELEVANCE_ROUTER_ALLOW_ON_ERROR=1

# SNS_INGESTION.md Phase 2 — 대표 포스터 이미지 OCR (Stage 3)
POSTER_OCR=auto
OPENAI_POSTER_OCR_MODEL=gpt-5-mini

# SNS_INGESTION.md Phase 2 — 로컬 CLIP 시각 선별(Stage 2). 비용 0원, 모델은 첫 실행 시 자동 다운로드.
POSTER_CLIP_CLASSIFIER=auto
POSTER_CLIP_MIN_CONFIDENCE=0.5
POSTER_CLIP_MODEL_NAME=ViT-B-32
POSTER_CLIP_PRETRAINED=openai

# SNS_INGESTION.md Phase 2 — 마감일 파서 LLM 폴백 (정규식 실패 시에만 호출)
POSTER_DEADLINE_PARSER=auto
OPENAI_POSTER_DEADLINE_MODEL=gpt-5-mini

# SNS_INGESTION.md Phase 4 — 기관 커버리지 등급(게시판완결/게시판부실/SNS-only) 산정 임계값
COVERAGE_OVERLAP_THRESHOLD=0.7

# 기존 posters 카테고리를 새 10개 체계로 재분류(poster-category-classifier.js)
POSTER_CATEGORY_CLASSIFIER=auto
OPENAI_POSTER_CATEGORY_MODEL=gpt-5-mini

# 이미지 phash 계산(image-phash.js) — 대표이미지(해상도 우선) 자동선정에 사용. 비용 0원(로컬 계산).
POSTER_IMAGE_PHASH=auto

# 정규식이 못 채운 공고 필드(기간/대상/내용/신청방법/장소/문의처)만 LLM으로 보완(notice-facts-extractor.js).
# 정규식이 이미 NOTICE_FACTS_MIN_REGEX_FIELDS개 이상 채웠으면 호출을 건너뛴다.
NOTICE_FACTS_EXTRACTOR=auto
OPENAI_NOTICE_FACTS_MODEL=gpt-5-mini
NOTICE_FACTS_MIN_REGEX_FIELDS=3
