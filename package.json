{
  "name": "posterlink-monorepo",
  "version": "0.1.0",
  "description": "PosterLink - 공공 포스터 애그리게이션 플랫폼",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:mobile": "pnpm --filter @posterlink/mobile start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "postinstall": "node apps/mobile/scripts/patch-expo-device-xcode26.js",
    "test": "tsx --test \"apps/web/app/admin/collection-sources/config-schema.test.ts\" \"apps/web/lib/adminPosterFilters.test.ts\" \"apps/web/lib/discoveryRoutes.test.ts\" \"apps/web/lib/posterApplication.test.ts\" \"apps/web/lib/posterCalendar.test.ts\" \"apps/web/lib/posterImage.test.ts\" \"apps/web/lib/posterStructuredEditor.test.ts\" \"apps/web/lib/posterStructuredSeo.test.ts\" \"apps/web/lib/posterStructuredTrust.test.ts\" \"apps/web/lib/posterSummaryFacts.test.ts\" \"apps/web/lib/siteVisitClassification.test.ts\" \"apps/web/lib/trafficAnalytics.test.ts\"",
    "audit:phase1": "node scripts/audit-phase1.mjs",
    "eval:sample": "pnpm --filter posterlink-crawler eval:sample",
    "eval:review-batches": "pnpm --filter posterlink-crawler eval:review-batches",
    "eval:validate": "pnpm --filter posterlink-crawler eval:validate",
    "eval:extraction": "pnpm --filter posterlink-crawler eval:extraction",
    "poster-detection:backfill": "pnpm --filter posterlink-crawler poster-detection:backfill",
    "content-type:backfill": "pnpm --filter posterlink-crawler content-type:backfill",
    "tier:compute": "pnpm --filter posterlink-crawler tier:compute",
    "ai:routing": "pnpm --filter posterlink-crawler ai:routing",
    "field-reports:process": "pnpm --filter posterlink-crawler field-reports:process",
    "collect": "tsx scripts/collect-posters.ts",
    "collect:youth": "tsx scripts/collect-posters.ts youth",
    "collect:central": "tsx scripts/collect-posters.ts central",
    "collect:local": "tsx scripts/collect-posters.ts local",
    "collect:subsidy": "tsx scripts/collect-posters.ts subsidy"
  },
  "devDependencies": {
    "dotenv": "^16.0.0",
    "esbuild": "^0.27.7",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0"
  }
}
