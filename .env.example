# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App Specific
NEXT_PUBLIC_APP_URL=http://localhost:4000

# OAuth
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
# Naver sign-in (docs/NAVER_LOGIN_SECURITY_DESIGN_2026-11-01.md). Both switches stay false
# until the migration is applied and the release is approved. Hash keys: 32+ random characters,
# backed up outside the app; V2, V3 ... are added for rotation.
NAVER_LOGIN_ENABLED=false
NEXT_PUBLIC_NAVER_LOGIN_ENABLED=false
NAVER_ID_HASH_KEY_V1=
KAKAO_ADMIN_KEY=your_kakao_admin_key

# Observability
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Edge Functions
OPENAI_API_KEY=your_openai_api_key
TAVILY_API_KEY=your_tavily_api_key

# Crawler poster verification
POSTER_IMAGE_CLASSIFIER=auto
POSTER_IMAGE_MIN_CONFIDENCE=0.65
POSTER_IMAGE_ALLOW_UNVERIFIED=0
POSTER_LOCAL_MODEL_PATH=
POSTER_LOCAL_MODEL_THRESHOLD=0.65
POSTER_AI_PYTHON=python
POSTER_CONTENT_VERIFIER=auto
POSTER_CONTENT_MIN_CONFIDENCE=0.6
POSTER_CONTENT_ALLOW_UNVERIFIED=0
POSTER_CONTENT_ALLOW_ON_ERROR=0
POSTER_IMAGE_VERIFY_TOP_N=4
CRAWLER_ADMIN_RUN_ENABLED=0
CRAWLER_ADMIN_RUN_TIMEOUT_MS=600000

# Admin background workflows
# Fine-grained GitHub token with Actions: write access to the target repository.
GITHUB_ACTIONS_TOKEN=
GITHUB_AI_REVIEW_REPOSITORY=maxmini0130/PosterLink
GITHUB_AI_REVIEW_WORKFLOW_ID=ai-review-queue.yml
GITHUB_AI_REVIEW_REF=main

# Operator-confirmed temporary company mailbox. Empty/false disables the channel.
NEXT_PUBLIC_WITHDRAWAL_REQUEST_URL=mailto:maxmini@maxmini.co.kr
NEXT_PUBLIC_WITHDRAWAL_CONTACT_VERIFIED=true

# GA4 defaults remain disabled; public measurement ID is provided per environment.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_ENABLED=false
NEXT_PUBLIC_GA_POLICY_REVIEWED=false
NEXT_PUBLIC_GA_ALLOW_NON_PRODUCTION=false
NEXT_PUBLIC_GA_DEBUG=false
